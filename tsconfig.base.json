{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mypos/domain": ["packages/domain/src/index.ts"],
      "@mypos/domain/*": ["packages/domain/src/*"],
      "@mypos/ui-web": ["packages/ui-web/src/index.ts"],
      "@mypos/ui-web/*": ["packages/ui-web/src/*"]
    }
  }
}
