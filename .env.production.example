NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://pos.example.com,https://qr.example.com,https://kds.example.com
VITE_API_BASE_URL=https://pos-api.example.com
NEXT_PUBLIC_API_BASE_URL=https://pos-api.example.com
EXPO_PUBLIC_API_BASE_URL=https://pos-api.example.com
KDS_API_KEY=replace-with-kds-api-key
VITE_KDS_TOKEN=replace-with-kds-api-key
DATABASE_URL=postgresql://mypos_user:replace-with-password@postgres.example.com:5432/mypos
REDIS_URL=redis://redis.example.com:6379
JWT_SECRET=replace-with-64-plus-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-64-plus-random-characters
R2_BUCKET=mypos-assets
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_API_BASE=https://api.line.me
FCM_PROJECT_ID=replace-with-fcm-project-id
PROMPTPAY_MERCHANT_ID=replace-with-promptpay-merchant-id
PROMPTPAY_MERCHANT_PHONE=replace-with-promptpay-phone
PAYMENT_PROMPTPAY_PROVIDER=PROMPTPAY_REAL
PAYMENT_CARD_PROVIDER=OMISE_REAL
PAYMENT_CHECKOUT_BASE_URL=https://pay.example.com
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
OMISE_PUBLIC_KEY=replace-with-omise-public-key
OMISE_SECRET_KEY=replace-with-omise-secret-key
TWOC2P_MERCHANT_ID=replace-with-2c2p-merchant-id
TWOC2P_SECRET_KEY=replace-with-2c2p-secret-key
ETAX_PROVIDER=RD_REAL
ETAX_FORCE_FAIL=false
RD_API_BASE=https://etax.rd.go.th
RD_CLIENT_ID=replace-with-rd-client-id
RD_CLIENT_SECRET=replace-with-rd-client-secret
RECEIPT_EMAIL_PROVIDER=SMTP
RECEIPT_LINE_PROVIDER=LINE_OA
RECEIPT_PRINT_PROVIDER=TCP_PRINTER
PRINTER_TCP_MAP=main=192.168.1.50:9100,kitchen=192.168.1.51:9100
PRINTER_TCP_TIMEOUT_MS=3000
PRINTER_TCP_MODE=ESCPOS
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=receipts@example.com
